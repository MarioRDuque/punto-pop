{
  "name": "punto-pop",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:visual-audit": "playwright test -c e2e/visual-audit/playwright.visual.config.ts",
    "e2e:report": "playwright show-report",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix"
    ],
    "*.{ts,html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@ag-grid-community/locale": "^35.0.1",
    "@angular/animations": "^20.3.15",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.15",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "ag-grid-angular": "^35.0.0",
    "ag-grid-community": "^35.0.0",
    "ag-grid-enterprise": "^35.0.0",
    "chart.js": "^4.5.1",
    "primeclt": "^0.1.5",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "print-js": "^1.6.0",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.0.8",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}
